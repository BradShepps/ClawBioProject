# Copy to .env (done automatically by `mise run setup`). Uncomment + fill in the keys you have;
# blank uncommented keys would override values already exported in your shell.
# .env is gitignored — never commit real keys.

# --- LLM providers ---------------------------------------------------------
# Anthropic (Claude): https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# --- Literature APIs (optional, raise rate limits) -------------------------
# NCBI E-utilities / PubMed: https://www.ncbi.nlm.nih.gov/account/settings/
# NCBI asks for an email with every request.
# NCBI_API_KEY=
# NCBI_EMAIL=
# Semantic Scholar: https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_API_KEY=

# --- ClawBio-specific (optional) -------------------------------------------
# FLock — only for ClawBio's Bio Orchestrator with --provider flock
# FLOCK_API_KEY=
# Genomic Intelligence DNA-LM API (gi-* skills). ClawBio's shared hackathon key
# is in vendor/ClawBio/.env.example if you need it.
# GI_API_KEY=
